# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=your_resend_api_key

# OpenAI (used by Ops Copilot)
OPENAI_API_KEY=your_openai_api_key

# Twilio (used by Ops Copilot staff alert SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Google Analytics (GA4 measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GitHub (required for hackathon AI screening / repo fetch)
# Use a fine-grained or classic PAT that can read public repos.
# Without a valid token, GitHub caps at ~60 req/hr (AI screening uses ~20 calls/team → Analyze All will fail).
# With a valid token: 5,000 req/hr. Verify: curl -H "Authorization: Bearer $GITHUB_TOKEN" https://api.github.com/rate_limit
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Anthropic (required for hackathon AI screening passes)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# App (set to your production URL on Render so Table QR links show correctly in admin)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Luma (auto check-in + credit assignment; both require Luma Plus)
# API key: luma.com/calendar/manage/api-keys · Webhook secret: calendar Settings → Developer → Webhooks
LUMA_API_KEY=secret-your-luma-api-key
LUMA_WEBHOOK_SECRET=whsec_your_luma_webhook_secret
